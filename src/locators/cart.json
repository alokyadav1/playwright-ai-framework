{
  "headerCartItemCountText": "a[href$=\"/cart\"] p",
  "itemRows": "div[class*=\"lcs-borderRadius-2xl\"][class*=\"border-[#CCCCCC]\"]:visible",
  "itemRowByVariantId": "div[class*=\"lcs-borderRadius-2xl\"][class*=\"border-[#CCCCCC]\"]:visible:has(a[href*=\"/{variantId}?sectionKey=Cart\"])",
  "itemImage": "a[href*=\"/{variantId}?sectionKey=Cart\"]:visible img",
  "itemNameLink": "a[href*=\"/{variantId}?sectionKey=Cart\"]:visible:not(:has(img))",
  "itemQuantityInput": "input[type=\"number\"]:visible",
  "itemUnitPriceText": ".lcs-text-black.lcs-text-xl",
  "itemLineTotalText": ".offer-amount:visible"
}
